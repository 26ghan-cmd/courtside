{
  "manifest_version": 3,
  "name": "Courtside",
  "version": "1.0.0",
  "description": "Live stats, game analysis, and a watch-party chat for college basketball streams.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Courtside",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.espn.com/watch/*",
        "https://plus.espn.com/*",
        "https://www.peacocktv.com/*",
        "https://www.foxsports.com/*",
        "https://www.cbssports.com/*",
        "https://www.paramountplus.com/*",
        "https://play.max.com/*",
        "https://tv.youtube.com/*",
        "https://www.youtube.com/*",
        "https://www.fubo.tv/*",
        "https://watch.sling.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://courtside-api-qd40.onrender.com/join/*",
        "http://localhost:8000/join/*"
      ],
      "js": [
        "join.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
